---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, lede, crumbs } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {
      crumbs && (
        <div class="breadcrumb">
          {crumbs.map((c) => (
            <>
              <a href={c.href}>{c.label}</a> ›{' '}
            </>
          ))}
        </div>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</section>
