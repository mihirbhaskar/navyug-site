---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

type Row = { label: string; n?: number | string; pct?: number | string };

const demographics: Row[] = [
  { label: 'Migrant family — Yes', n: 73, pct: 40.6 },
  { label: 'Social category — OBC', n: 78, pct: 43.3 },
  { label: 'Social category — SC', n: 29, pct: 16.1 },
  { label: 'Social category — ST', n: 13, pct: 7.2 },
  { label: 'Social category — General', n: 28, pct: 15.6 },
  { label: 'Household size (mean)', n: 4.7, pct: '—' },
  { label: 'Children per household (mean)', n: 1.9, pct: '—' },
];
const income: Row[] = [
  { label: 'Less than ₹5,000', n: 25, pct: 13.9 },
  { label: '₹5,000 – 9,999', n: 52, pct: 28.9 },
  { label: '₹10,000 – 14,999', n: 57, pct: 31.7 },
  { label: '₹15,000 – 24,999', n: 28, pct: 15.6 },
  { label: '₹25,000 – 49,999', n: 6, pct: 3.3 },
  { label: 'No regular income', n: 5, pct: 2.8 },
];
const schemes: Row[] = [
  { label: 'Aadhaar — all household members', pct: 84.0 },
  { label: 'Aadhaar — children only', pct: 94.2 },
  { label: 'Ration card', pct: 61.1 },
  { label: 'PMJAY / Ayushman Bharat card received', pct: 16.1 },
