---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';

const RUBBLE = 'https://thepatriot.in/reports/rising-from-the-rubble-33882';
---

<Base title="प्रभाव और शोध">
  <PageHero
    eyebrow="प्रभाव और शोध"
    title="अब तक हमने क्या किया है"
    lede="NSF के रजिस्टर होने से पहले हमारा ज़्यादातर काम पढ़ाना था, और उसमें से बहुत कुछ अनौपचारिक था। इसके साथ हमने दो और तरह के काम का रिकॉर्ड रखा: समुदाय को समझने के लिए शोध, और राहत, जब किसी संकट की वजह से पढ़ाई नामुमकिन हो गई।"
  />

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="prose">
          <p class="eyebrow">1 · पढ़ाई</p>
          <h2 style="margin-top:0">दस साल से ज़्यादा समय से, ज़्यादातर अनौपचारिक</h2>
          <p>
            दस साल से ज़्यादा समय से हमारी ज़्यादातर पढ़ाई अनौपचारिक रूप से हुई है: झुग्गियों में मुफ़्त कक्षाएँ, और
            वनफूल पाठशाला में कक्षाएँ — यमुना खादर का एक मुफ़्त स्कूल जिसे चलाने में विक्रम ने मदद की, और जो 2020 तक
            फ़्लाईओवर के नीचे कक्षाएँ लगाकर <span class="hl">लगभग 300 बच्चों</span> तक पहुँच रहा था
            (<a href={RUBBLE}>"Rising from the rubble", The Patriot</a>)। हमने RTE/EWS कोटे के तहत
            <span class="hl">200+ बच्चों का स्कूल में दाखिला</span> करवाने में भी मदद की है।
          </p>
          <p>
            यह काम अनौपचारिक था, इसलिए इसका ज़्यादातर हिस्सा हर बच्चे के स्तर पर दर्ज नहीं हुआ। जिन दो उदाहरणों पर हमने
            करीब से नज़र रखी, वे हैं <a href="/hi/stories">पुष्पा और रूपम →</a>। अब NSF के साथ हम अपने
            <a href="/hi/donate">पायलट कार्यक्रम</a> के हर बच्चे के लिए लक्ष्य तय करते हैं और साल भर उसकी प्रगति पर नज़र रखते हैं।
          </p>
        </div>
        <img src="/images/community/teaching.jpeg" alt="यमुना खादर में अनौपचारिक कक्षा के लिए इकट्ठा हुए बच्चे" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="split">
        <div class="prose">
          <p class="eyebrow">2 · सर्वे और शोध</p>
          <h2 style="margin-top:0">जिस समुदाय के साथ हम काम करते हैं, उसे समझना</h2>
          <p>
            जिन बच्चों को हमारी ज़रूरत है उन्हें ढूँढने, उनके हालात समझने और प्रगति को परखने के लिए हम कई तरह के सर्वे
            करते हैं। 2020 की हमारी जनगणना (सर्वे) में <span class="hl">1,495 घरों</span> (6,385 लोगों) का नक्शा बनाया
            गया, और <strong>300 ऐसे बच्चे मिले जो कभी स्कूल नहीं गए थे</strong> और <strong>112 जिनकी पढ़ाई छूट गई थी</strong>।
            जून 2026 के हमारे घर-घर सर्वे और फिर परिवारों से फ़ोन पर बातचीत से हमारे मौजूदा पायलट कार्यक्रम के
            <a href="/hi/programs">28 बच्चों</a> की पहचान हुई।
          </p>
          <p><a href="/hi/impact/surveys-and-research">सर्वे और उनके नतीजे देखें →</a></p>
        </div>
        <a href="/hi/impact/surveys-and-research"><img src="/images/research/fullmap.png" alt="2020 के सामुदायिक सर्वे में घरों की सघनता का नक्शा" loading="lazy" /></a>
      </div>
    </div>
  </section>

  <section class="section" id="relief">
    <div class="container">
      <p class="eyebrow">3 · राहत</p>
      <p class="statement">
        हमारा ध्यान बच्चों की पढ़ाई में मदद करने पर है, लेकिन
        <span class="soft">हम जानते हैं कि समुदाय और घर से जुड़ी कई बातें पढ़ाई को मुश्किल बनाने में बड़ी भूमिका निभाती
        हैं। इसलिए पढ़ाई के साथ-साथ हमने पहले तूफ़ान राहत, मच्छरदानियों और राशन सहायता के लिए सीमित और तय दायरे वाले
        अभियान चलाए हैं।</span>
      </p>
      <div class="cards four" style="margin-top:28px">
        <a class="card" href="/hi/impact/storm-relief">
          <img src="/images/storm/after2.jpeg" alt="नए वॉटरप्रूफ़ तिरपाल से ढकी झोपड़ियाँ" loading="lazy" />
          <div class="body">
            <h3>तूफ़ान राहत</h3>
            <p>जून 2020 के तूफ़ान में टूटी झोपड़ियों को फिर से बनाने के लिए 121 परिवारों को वॉटरप्रूफ़ तिरपाल।</p>
            <span class="more">और पढ़ें →</span>
          </div>
        </a>
        <a class="card" href="/hi/impact/mosquito-nets">
          <img src="/images/nets/dist2.jpeg" alt="मच्छरदानियों का वितरण" loading="lazy" />
          <div class="body">
            <h3>मच्छरदानियाँ</h3>
            <p>2020 के मानसून से पहले 50 से ज़्यादा दानदाताओं की मदद से 660 कीटनाशक-युक्त मच्छरदानियाँ मुफ़्त बाँटी गईं।</p>
            <span class="more">और पढ़ें →</span>
          </div>
        </a>
        <div class="card">
          <img src="/images/community/gallery3.jpeg" alt="यमुना खादर बस्ती के घर" loading="lazy" />
          <div class="body">
            <h3>COVID-19 राशन राहत</h3>
            <p>COVID-19 लॉकडाउन के दौरान 800+ परिवारों को राशन किट दी गईं, जिन्हें विक्रम ने बस्ती सुरक्षा मंच के साथ मिलकर बाँटा।</p>
          </div>
        </div>
        <div class="card">
          <img src="/images/community/house1.jpeg" alt="यमुना खादर का एक घर" loading="lazy" />
          <div class="body">
            <h3>दस्तावेज़ कैंप</h3>
            <p>परिवारों को वोटर ID, राशन कार्ड और आधार के लिए आवेदन करने में मदद के कैंप — यही वे दस्तावेज़ हैं जिन पर स्कूल में दाखिला और सरकारी योजनाएँ निर्भर करती हैं।</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
