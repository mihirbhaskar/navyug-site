---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
const mapUrl = 'https://www.google.com/maps/d/viewer?mid=1emmaMnDHtxVKNfdo4X0W8LTs5erOo5UJ&ll=28.594867628626265%2C77.27872214999998&z=13';
---

<Base title="मच्छरदानी वितरण">
  <PageHero
    crumbs={[{ href: '/hi/impact', label: 'प्रभाव और शोध' }]}
    eyebrow="राहत अभियान · अगस्त–सितंबर 2020"
    title="मच्छरदानी वितरण"
    lede="660 कीटनाशक-युक्त मच्छरदानियाँ, मुफ़्त बाँटी गईं।"
  />

  <section class="section">
    <div class="container prose">
      <h2>समस्या</h2>
      <p>
        मानसून के साथ आमतौर पर डेंगू, मलेरिया, चिकनगुनिया और मच्छरों से फैलने वाली दूसरी बीमारियों के मामले तेज़ी से
        बढ़ जाते हैं। यह बस्ती कुछ कारणों से ख़ास तौर पर जोखिम में है:
      </p>
      <ol>
        <li>पानी के पास होना; यह बस्ती सीधे <a href={mapUrl}>यमुना नदी</a> के किनारे बसी है</li>
        <li>
          परिवार झोपड़ियों या कच्चे घरों में रहते हैं, जो बाहर के माहौल से ठीक से बचाव नहीं करते
          <img src="/images/community/house1.jpeg" alt="बस्ती का एक कच्चा घर" style="max-width:320px;margin:12px 0;border-radius:10px" loading="lazy" />
        </li>
        <li>
          बचाव के दूसरे साधनों की कमी: हमारे <a href="/hi/impact/surveys-and-research#census-2020">'जनगणना'
          सर्वे</a> में हमने पाया कि <strong>99% परिवारों के पास मच्छरदानी नहीं है या वे फटी हुई मच्छरदानी इस्तेमाल करते हैं।</strong>
          हमने देखा है कि कुछ परिवार इसकी जगह पतली साड़ियों का इस्तेमाल करते हैं, लेकिन इससे कोई फ़ायदा नहीं होता।
        </li>
        <li>
          छोटे बच्चों की बड़ी संख्या; <strong>35% परिवारों में कम से कम एक बच्चा 5 साल से कम उम्र का है, और बस्ती में
          ऐसे कुल 712 बच्चे हैं।</strong> माना जाता है कि छोटे बच्चे और गर्भवती महिलाएँ
          <a href="https://www.who.int/malaria/areas/high_risk_groups/infants/en/">मलेरिया के लिए सबसे ज़्यादा जोखिम वाले समूह</a> हैं।
        </li>
      </ol>
      <p>
        बारिश न हो तब भी, शाम और रात भर मच्छरों का काटना यहाँ के लोगों के लिए आम परेशानी है।
        <a href="https://www.newindianexpress.com/cities/chennai/2019/sep/19/are-the-urban-poor-sleep-deprived-2035819.html">J-PAL
        के एक हालिया अध्ययन</a> ने दिखाया कि शहरी ग़रीबों को अच्छी नींद लेने में बड़ी रुकावटों का सामना करना पड़ता है,
        जिसका असर उनकी कार्यक्षमता, फ़ैसले लेने, सेहत और जीवन की गुणवत्ता पर पड़ सकता है।
      </p>

      <h2>हमने क्या किया</h2>
      <p>
        <a href="https://www.afro.who.int/news/treated-mosquito-nets-are-safe-and-effective">कीटनाशक-युक्त मच्छरदानियाँ</a>
        मच्छरों से फैलने वाली बीमारियों को रोकने का सबसे सुरक्षित और सबसे किफ़ायती तरीक़ा मानी जाती हैं। कई अध्ययनों से
        अब यह भी साबित हो चुका है कि <strong>मुफ़्त वितरण</strong> से, कीमत लेने या लागत बाँटने के बाकी सभी तरीक़ों
        की तुलना में, ज़्यादा लोगों तक मच्छरदानी पहुँचती है और ज़्यादा लोग उसे अपनाते हैं (देखें
        <a href="https://www.povertyactionlab.org/evaluation/adoption-insecticide-treated-bednets-among-poor-households-orissa-india">यहाँ</a>,
        <a href="https://www.povertyactionlab.org/evaluation/role-exposure-social-networks-and-marketing-messages-households-willingness-pay-malaria">यहाँ</a>,
        <a href="https://www.povertyactionlab.org/evaluation/free-distribution-or-cost-sharing-evidence-malaria-prevention-experiment-kenya">यहाँ</a>
        और <a href="https://www.who.int/mediacentre/news/releases/2007/pr43/en/">यहाँ</a>)।
      </p>
      <p>
        50 से ज़्यादा लोगों के उदार दान की मदद से, हम <strong>कुल 660 कीटनाशक-युक्त मच्छरदानियाँ मुफ़्त
        बाँट पाए।</strong> नीचे वितरण की कुछ तस्वीरें हैं, और आप एक छोटा वीडियो
        <a href="https://drive.google.com/file/d/1S0H9MG1Ys9WD-q9dn1HyHJamSilqiGBL/view">यहाँ</a> देख सकते हैं।
      </p>
    </div>
    <div class="container">
      <div class="photos tall">
        <img src="/images/nets/dist1.jpeg" alt="मच्छरदानी लेते हुए बस्ती की एक निवासी" loading="lazy" />
        <img src="/images/nets/dist2.jpeg" alt="मच्छरदानी वितरण" loading="lazy" />
        <img src="/images/nets/dist3.jpeg" alt="मच्छरदानी वितरण" loading="lazy" />
      </div>
    </div>
    <div class="container prose">
      <h2>और जानकारी और कुछ विचार</h2>
      <h3>ख़रीद और फ़ंडिंग</h3>
      <ul>
        <li>
          मच्छरदानियों के लिए विक्रेता चुनने के लिए हमने 5 अलग-अलग जगहों से दाम मँगवाए। जो हमारी गुणवत्ता की शर्तों
          (टिकाऊ और कीटनाशक-युक्त) पर खरी उतरीं, उनमें मोल-भाव के बाद सबसे कम दाम INR 284 प्रति मच्छरदानी था
          (5% GST सहित)। मच्छरदानियाँ 7 खेपों में ख़रीदी और लाई गईं - आप सभी रसीदें
          <a href="https://www.dropbox.com/sh/c5lz4qskj9vp6z3/AAArAmu11HM3mvKw8MkBnBbxa?dl=0">यहाँ</a> देख सकते हैं
        </li>
        <li>
          हमने ज़्यादातर पैसा <a href="https://www.ketto.org/fundraiser/mosquito-net-distribution-for-slum-dwellers-in-delhi">Ketto.org
          पर एक अभियान</a> के ज़रिए जुटाया। सभी मच्छरदानियों की कुल लागत INR 1,87,110 थी, जिसमें से INR 1,81,625
          फ़ंडरेज़र अभियान से आए। बाकी पैसा लोगों ने अलग-अलग Google Pay से भेजा।
        </li>
      </ul>
      <h3>वितरण</h3>
      <ul>
        <li>
          ज़्यादातर वितरण 31 अगस्त से 11 सितंबर 2020 के बीच हुआ। भारी बारिश से कच्चे रास्तों में पानी भर जाने के
          कारण हर घर तक मच्छरदानी पहुँचाना मुमकिन नहीं था, इसलिए हमने हर 'ब्लॉक' के लिए वितरण केंद्र बनाए (आप इन
          ब्लॉकों की सीमाएँ <a href="/hi/#community-map">यहाँ</a> देख सकते हैं)।
        </li>
        <li>
          सरकारी योजनाओं में गलत लोगों के शामिल होने या सही लोगों के छूट जाने के कई उदाहरण देखने के बाद, हमने तय किया
          कि मच्छरदानी पाने के लिए कोई सख़्त शर्त नहीं रखी जाएगी। फिर भी, हमने अपने जनगणना सर्वे से मिली जानकारी के
          ज़रिए छोटे बच्चों वाले परिवारों से ख़ास तौर पर संपर्क किया और उन्हें मच्छरदानी लेने के लिए प्रोत्साहित किया।
          आख़िर में जिन 660 परिवारों को मच्छरदानी मिली, उनमें से 350 में 5 साल से कम उम्र का बच्चा था।
        </li>
        <li>
          वितरण का रिकॉर्ड रखने और उस पर नज़र रखने के लिए, हमने एक डिजिटल फ़ॉर्म बनाया जो हर मच्छरदानी देते समय
          भरा जाता था। जहाँ मुमकिन हुआ, लेने वालों ने पहचान की जानकारी (फ़ोन/आधार/राशन कार्ड) दी, जिससे उन्हें हमारे
          पिछले सर्वे से मिलाया जा सके। जो नहीं मिले, उनके नाम और फ़ोन नंबर लिए गए। 24% लेने वाले हमारे जनगणना डेटा
          से मेल नहीं खाए - हमें लगता है कि इनमें से कई ऐसी महिलाएँ थीं जो लॉकडाउन के बाद लौटी थीं और इसलिए हमारे
          सर्वे में छूट गई थीं।
        </li>
      </ul>
    </div>
  </section>
</Base>
