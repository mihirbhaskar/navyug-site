---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---

<Base title="हमारे कार्यक्रम">
  <PageHero
    eyebrow="हमारे कार्यक्रम"
    title="बच्चों की पढ़ाई जारी रखना"
    lede="जब पलायन, आपदा या घर की आर्थिक तंगी के कारण बच्चों की पढ़ाई रुक जाती है, तब उसे आगे जारी रखने में उनकी मदद करना।"
  />

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="prose">
          <h2 style="margin-top:0">स्कूल में वापस लौटना मुश्किल क्यों है</h2>
          <p>
            यहाँ के बच्चे तब स्कूल छोड़ देते हैं जब पलायन, बाढ़, तोड़फोड़ या पैसों की तंगी उनके परिवार की ज़िंदगी को
            उलट-पलट कर देती है (<a href="/hi/about#problem">बच्चे स्कूल क्यों छोड़ते हैं →</a>)। स्कूल छोड़ने से कहीं
            ज़्यादा मुश्किल है वापस लौटना।
          </p>
          <p>
            बच्चे स्कूल लौटना चाहें, तब भी यह दो कारणों से मुश्किल होता है। पहला, वे अपनी उम्र से नीचे की कक्षा में
            दोबारा दाखिला नहीं ले सकते; नियम के अनुसार उन्हें अपनी उम्र वाली कक्षा में ही दाखिला मिलता है। दूसरा, कई
            साल की पढ़ाई छूट जाने के कारण वे अपनी उम्र वाली कक्षा में आगे बढ़ने के लिए तैयार नहीं होते। इसी वजह से
            ज़्यादातर बच्चे स्कूल से बाहर ही रह जाते हैं।
          </p>
        </div>
        <img src="/images/community/kids_learning.jpeg" alt="यमुना खादर में साथ बैठकर पढ़ते बच्चे" />
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2 style="margin-top:0">हमारा तरीका</h2>
      <p class="prose">
        किसी बच्चे की पढ़ाई जारी रखने के लिए एक चीज़ काफ़ी नहीं होती, इसलिए हम हर बच्चे की स्थिति के हिसाब से पाँच
        मोर्चों पर काम करते हैं।
      </p>
      <div class="pathways" style="margin-top:24px">
        <div class="pathway">
          <p class="eyebrow">1</p>
          <h3>NIOS के ज़रिए ओपन स्कूलिंग</h3>
          <p>
            राष्ट्रीय मुक्त विद्यालयी शिक्षा संस्थान (NIOS) से छात्र किसी नियमित स्कूल की पते और हाज़िरी वाली शर्तों के
            बिना 10वीं और 12वीं पूरी कर सकते हैं; दाखिले के लिए सिर्फ़ आधार कार्ड और पिछली मार्कशीट चाहिए। बहुत से
            परिवारों को पता ही नहीं कि यह विकल्प मौजूद है।
          </p>
          <p>
            जब कोई बच्चा पढ़ाई छोड़ चुका हो लेकिन आगे पढ़ना चाहता हो, तो विक्रम सिंह और हमारी शिक्षण टीम सबसे पहले
            परिवार को NIOS में दाखिले के लिए ज़रूरी दस्तावेज़ तैयार करने में मदद करती है। कागज़ात पूरे होने के बाद विक्रम
            खुद NIOS का पाठ्यक्रम पढ़ाते हैं — हर बच्चे की उम्र से नहीं, बल्कि उसके असली स्तर से शुरू करके — NIOS की 10वीं
            और 12वीं की बोर्ड परीक्षा के लिए रजिस्ट्रेशन में मदद करते हैं, और पास होने तक साथ देते हैं।
          </p>
          <a href="/hi/stories">पढ़ें कि पुष्पा और रूपम के लिए यह कैसे काम आया →</a>
        </div>
        <div class="pathway">
          <p class="eyebrow">2</p>
          <h3>स्कूल में दाखिले के लिए दस्तावेज़</h3>
          <p>
            दिल्ली में नए आए परिवारों को अक्सर आधार, जन्म प्रमाण पत्र और दूसरे कागज़ात बनवाने में मदद की ज़रूरत होती
            है, ताकि उनके बच्चे सरकारी या प्राइवेट स्कूलों में दाखिला ले सकें। यही दस्तावेज़ हेल्प-डेस्क आयुष्मान भारत,
            सुकन्या समृद्धि, POCSO और पेंशन योजनाओं की जानकारी देने और उन तक पहुँचने में भी मदद करता है।
          </p>
        </div>
        <div class="pathway">
          <p class="eyebrow">3</p>
          <h3>ब्रिज शिक्षा</h3>
          <p>
            जो बच्चे पढ़ाई में पीछे रह गए हैं, उन्हें हर बच्चे के हिसाब से बनी, बहुत व्यक्तिगत पढ़ाई की ज़रूरत होती है,
            जो पहले यह समझे कि बच्चा असल में किस स्तर पर है, और फिर उसे बराबरी पर लाने में मदद करे। उम्र और हालात के
            हिसाब से लक्ष्य होता है या तो उन्हें दोबारा स्कूल में दाखिला दिलाना, या NIOS के ज़रिए 10वीं या 12वीं की
            परीक्षा पास करने के लिए तैयार करना।
          </p>
        </div>
        <div class="pathway">
          <p class="eyebrow">4</p>
          <h3>रोल मॉडल और परिवार का साथ</h3>
          <p>
            परिवारों को यह भरोसा दिलाना कि पढ़ाई जारी रखना फ़ायदेमंद है, उतना ही ज़रूरी है जितना पढ़ाना। इसी समुदाय के
            जिन छात्रों ने अपनी पढ़ाई पूरी की है, जैसे <a href="/hi/stories">पुष्पा और रूपम</a>, वे दिखाते हैं कि क्या
            मुमकिन है, और कार्यक्रम से जुड़ने वाले हर बच्चे की कहानी पर हम नज़र रखेंगे और उसे साझा करेंगे। अपने ही
            समुदाय के लोगों से मिलने वाली सलाह और मार्गदर्शन बच्चों का आत्मविश्वास और हौसला फिर से बनाने में मदद करते हैं।
          </p>
        </div>
        <div class="pathway">
          <p class="eyebrow">5</p>
          <h3>कौशल प्रशिक्षण और नौकरी</h3>
          <p>
            NIOS की परीक्षा पास करने के बाद NSF छात्रों को नौकरी से जोड़ने में मदद करता है। पढ़ाई छोड़ चुका हर बच्चा
            दोबारा औपचारिक पढ़ाई नहीं करना चाहता। ऐसे बच्चों के लिए NSF कौशल प्रशिक्षण वर्कशॉप — मुख्य रूप से सिलाई —
            करवाता है और फिर उन्हें नौकरी दिलाने में मदद करता है। यह काम अभी चल रहे 28 बच्चों वाले पायलट कार्यक्रम से
            अलग है, जिसका ध्यान NIOS के ज़रिए पढ़ाई में वापसी पर है।
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2 style="margin-top:0">हम क्या कर रहे हैं</h2>
      <p>
        शुरुआती पायलट कार्यक्रम के तौर पर हमने एक <a href="/hi/impact/surveys-and-research#survey-2026">घर-घर
        सर्वे</a> किया, फिर परिवारों से फ़ोन पर बात की, और ऐसे 28 बच्चों की पहचान की जिन्होंने जल्दी पढ़ाई छोड़ दी थी और
        जो दो शर्तें पूरी करते हैं: वे सीखने के लिए उत्सुक हैं, और उनके परिवार पढ़ाई में उनकी वापसी में साथ देने को तैयार
        हैं। हम इन 28 बच्चों को पढ़ाने, मार्गदर्शन देने और उनका साथ देने के लिए धन जुटा रहे हैं।
      </p>
      <div class="btn-row"><a class="btn accent" href="https://milaap.org/fundraisers/support-childen-who-have-dropped-out-of-school">Milaap पर पायलट कार्यक्रम का साथ दें</a><a class="btn ghost" href="/hi/donate">मदद के दूसरे तरीके</a></div>
    </div>
  </section>
</Base>
