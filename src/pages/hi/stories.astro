---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---

<Base title="कहानियाँ">
  <PageHero
    eyebrow="कहानियाँ"
    title="पढ़ाई का दूसरा मौका क्या कर सकता है"
    lede="यमुना खादर की दो युवतियाँ, जो NSF के रजिस्टर होने से पहले विक्रम की मदद से दोबारा पढ़ाई से जुड़ीं।"
  />

  <section class="section">
    <div class="container" style="max-width:900px">
      <article class="story with-photo">
        <img src="/images/stories/pushpa.jpg" alt="पुष्पा कुमारी" loading="lazy" />
        <div>
          <p class="eyebrow">NIOS के ज़रिए पढ़ाई में वापसी</p>
          <h2>पुष्पा कुमारी</h2>
          <p>
            पुष्पा का परिवार उत्तर प्रदेश के बदायूँ ज़िले के छोटे से कस्बे सहसवान में रहता था। जनवरी 2013 में उनके पिता
            काम की तलाश में दिल्ली की यमुना खादर की झुग्गियों में आ गए, और इस उथल-पुथल में पुष्पा और उनके भाई-बहनों की
            पढ़ाई पूरी तरह रुक गई — न कोई रिकॉर्ड, न आगे पढ़ने का कोई इंतज़ाम।
          </p>
          <p>
            उसी समय विक्रम — नवयुग के रजिस्टर होने से भी पहले — यमुना खादर की झुग्गियों में अनौपचारिक रूप से पढ़ा रहे
            थे। उन्होंने पुष्पा और उनके भाई सूरज को तीन महीने मुफ़्त पढ़ाया, फिर हलफ़नामे और कागज़ात तैयार करवाने में मदद
            की ताकि उनका दोबारा औपचारिक दाखिला हो सके: पुष्पा का कक्षा 7 में, सूरज का कक्षा 8 में।
          </p>
          <p>
            पुष्पा ने हिम्मत नहीं छोड़ी और हर कक्षा अच्छे नंबरों से पास की। 12वीं के बाद उन्होंने इग्नू (IGNOU) से B.A.
            पूरा किया, साथ ही ब्यूटी थेरेपी में छह महीने का डिप्लोमा भी किया। आज वे एक ब्यूटी पार्लर में काम करती हैं
            और अपने परिवार का मज़बूत आर्थिक सहारा हैं।
          </p>
        </div>
      </article>

      <article class="story with-photo">
        <img src="/images/stories/rupam.jpg" alt="रूपम कुमारी" loading="lazy" />
        <div>
          <p class="eyebrow">NIOS के ज़रिए पढ़ाई में वापसी</p>
          <h2>रूपम कुमारी</h2>
          <p>
            रूपम दिल्ली में ही पली-बढ़ीं; उनके पिता साइकिल रिक्शा चलाकर गुज़ारा करते हैं, और परिवार की आर्थिक हालत में
            बेटी की पढ़ाई को प्राथमिकता देने की गुंजाइश नहीं थी — उस समय समुदाय में यही आम सोच थी।
          </p>
          <p>
            विक्रम ने उनके दाखिले, परीक्षा की तैयारी और किताबों का इंतज़ाम किया, और लगातार उनका हौसला बढ़ाया, जिसमें
            उनके माता-पिता से यह बात करना भी शामिल था कि उनकी पढ़ाई परिवार के लिए क्या मायने रख सकती है।
          </p>
          <p>
            पैसों की तंगी, घर की ज़िम्मेदारियों और आस-पास के लोगों के दबाव के कारण उन्हें अक्सर घर का काम खत्म करके देर
            रात पढ़ना पड़ता था। उन्होंने कक्षा 8 से सीधे 10वीं की बोर्ड परीक्षा दी और पास हुईं, फिर 11वीं और 12वीं पूरी
            की। इसके बाद उन्होंने B.A. किया, और विक्रम की मदद से कंप्यूटर और इंग्लिश-स्पीकिंग कोर्स भी किए। आज वे एक
            मल्टीनेशनल कंपनी में डेटा एंट्री ऑपरेटर हैं और अपने घर के खर्च में हाथ बँटाती हैं।
          </p>
        </div>
      </article>

      <div class="prose">
        <p>
          ये दोनों हमारे कार्यक्रमों में बताए गए <a href="/hi/programs">NIOS के ज़रिए पढ़ाई में वापसी के रास्ते</a> के
          सीधे उदाहरण हैं — दोनों बार विक्रम ने खुद छात्रा को पढ़ाया और बोर्ड परीक्षा तक उनका मार्गदर्शन किया।
        </p>
        <div class="btn-row"><a class="btn accent" href="https://milaap.org/fundraisers/support-childen-who-have-dropped-out-of-school">अगले 28 बच्चों की मदद करें</a></div>
      </div>
    </div>
  </section>
</Base>
