---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

const src = {
  maktoob2024: 'https://maktoobmedia.com/post?id=91991&slug=4000-migrant-families-in-delhis-mayur-vihar-surviving-floods-muddy-winds-became-homeless-in-a-day',
  maktoob2026: 'https://maktoobmedia.com/post?id=116552&slug=homes-demolished-names-missing-from-voter-rolls-chilla-khadar-families-face-displacement-amid-delhi-sir',
  rubble2023: 'https://thepatriot.in/reports/rising-from-the-rubble-33882',
  patriot2023: 'https://thepatriot.in/cover-story/schools-submerged-studies-take-a-hit-38550',
  iwp2025: 'https://www.indiawaterportal.org/rivers-and-lakes/displacement/who-owns-the-yamuna-floodplain-migrant-farmers-landlords-or-the-dda',
};
---

<Base title="हमारे बारे में">
  <PageHero eyebrow="हमारे बारे में" title="हम कौन हैं" />

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="prose">
          <p>
            नवयुग संस्कृति फ़ाउंडेशन (NSF) एक ज़मीनी स्तर की गैर-लाभकारी संस्था है, जो पूर्वी दिल्ली के सबसे
            वंचित समुदायों में से एक के साथ काम करती है - यमुना के बाढ़ क्षेत्र में बसी प्रवासी बस्तियाँ। यहाँ ज़्यादातर परिवार
            उत्तर प्रदेश, बिहार, मध्य प्रदेश और हरियाणा के गाँवों से आए पहली या दूसरी पीढ़ी के प्रवासी हैं।
          </p>
          <h2 id="yamuna-khadar">यमुना खादर</h2>
          <p>
            यमुना खादर, मयूर विहार फ़ेज़-1 और चिल्ला खादर के पास यमुना के बाढ़ क्षेत्र का एक हिस्सा है। यहाँ ज़्यादातर
            परिवार पट्टे की ज़मीन पर सब्ज़ियाँ और नर्सरी के पौधे उगाते हैं, या दिहाड़ी मज़दूरी और घरेलू काम करते हैं
            (<a href={src.iwp2025}>India Water Portal, 2025</a>)। बाढ़ क्षेत्र में पक्का निर्माण करने की इजाज़त नहीं है, इसलिए
            घर तिरपाल और बाँस से बनी झुग्गियाँ हैं (<a href={src.maktoob2024}>Maktoob, 2024</a>)।
          </p>
          <p>
            बाढ़ (<a href={src.patriot2023}>जुलाई 2023</a>, <a href={src.iwp2025}>अगस्त–सितंबर 2025</a>) बार-बार
            परिवारों को सड़क किनारे राहत शिविरों में धकेल देती है, और डीडीए की तोड़फोड़ की कार्रवाइयों
            (<a href={src.maktoob2024}>जुलाई 2024</a>, <a href={src.iwp2025}>अप्रैल 2025</a>,
            <a href={src.maktoob2026}>सितंबर 2026</a>) ने कई बार घरों, खेतों और पढ़ाई की जगहों को उजाड़ा है। हर
            बार ऐसे उजड़ने पर बच्चे की पढ़ाई रुक सकती है।
          </p>
        </div>
        <img src="/images/community/gallery1.jpeg" alt="यमुना खादर में फ़्लाईओवर के नीचे झुग्गियाँ" />
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container prose">
      <h2 style="margin-top:0">मिशन</h2>
      <p>
        <strong>हमारा मिशन:</strong> यह पक्का करना कि गाँव से शहर आए प्रवासी परिवारों के बच्चे अपनी पढ़ाई पूरी करें, पढ़ाई छोड़ने के बार-बार आने वाले दबावों के सामने टिके रहें, और आगे चलकर स्थिर काम पाएँ।
      </p>
      <h3 id="problem">हम किस समस्या पर ध्यान देते हैं</h3>
      <p>यमुना खादर में बच्चों की पढ़ाई छूटने की कुछ मुख्य वजहें ये हैं:</p>
      <ul>
        <li>
          <strong>दिल्ली आने पर:</strong> गाँवों से आने वाले परिवारों के पास अक्सर पते का सबूत और वे दूसरे
          दस्तावेज़ नहीं होते जो शहर के स्कूल माँगते हैं, इसलिए जो बच्चे गाँव में पढ़ रहे थे, उनका शहर में दाख़िला ही नहीं हो पाता।
        </li>
        <li>
          <strong>अचानक गाँव लौटना:</strong> जब बाढ़, तोड़फोड़ या कोई और संकट परिवारों को वापस गाँव जाने पर मजबूर करता है,
          तो बच्चों का स्कूल साल के बीच में छूट जाता है और वे अक्सर दोबारा नहीं लौटते।
        </li>
        <li><strong>कमाई का दबाव:</strong> बच्चों को कमाने या घर के काम में हाथ बँटाने की ज़रूरत पड़ती है।</li>
      </ul>
      <p>एक बार बच्चा पीछे छूट जाए, तो फिर से पढ़ाई में लौटना मुश्किल होता है। <a href="/hi/programs">देखें हम कैसे काम करते हैं →</a></p>
    </div>
  </section>

  <section class="section" id="our-story">
    <div class="container prose">
      <h2 style="margin-top:0">हमारी कहानी</h2>
      <p>
        विक्रम सिंह 2013 में उत्तर प्रदेश के अपने गाँव से पढ़ाई के लिए दिल्ली आए। वे
        मयूर विहार की झुग्गियों में रहे, और वहीं रहते हुए उन्होंने दिल्ली विश्वविद्यालय से B.A. किया, और बाद में इग्नू (IGNOU) से B.Ed.
        और M.A. किया।
      </p>
      <p>
        झुग्गियों में रहते हुए उन्होंने दो बातें देखीं। पहली, कितने बच्चों का स्कूल छूट चुका था, वापस जाने का कोई साफ़ रास्ता
        नहीं था और पढ़ने का मन भी कम था; ज़्यादातर से उम्मीद की जाती थी कि वे खेतों के काम में माता-पिता का हाथ बँटाएँ। दूसरी,
        वापसी के रास्ते के रूप में ओपन स्कूलिंग (NIOS, राष्ट्रीय मुक्त विद्यालयी शिक्षा संस्थान) की संभावना। अपनी पढ़ाई के साथ-साथ उन्होंने
        बच्चों को मुफ़्त पढ़ाना शुरू किया, और आगे चलकर वनफूल पाठशाला चलाने में मदद की — यमुना खादर के बच्चों के लिए एक मुफ़्त स्कूल,
        जो 2020 तक फ़्लाईओवर के नीचे कक्षाएँ चला रहा था और लगभग 300 बच्चों तक पहुँच रहा था। सृष्टि वर्मा, जो अब हमारी
        सह-संस्थापक हैं, वहाँ उनके साथ पढ़ाती थीं।
      </p>
      <p>
        2020 में, कोविड-19 लॉकडाउन के दौरान, मिहिर भास्कर, जो उस समय डेटा और पब्लिक पॉलिसी रिसर्च में काम कर रहे थे,
        ज़मीन पर चल रहे राहत कामों तक पैसे पहुँचाने में स्वयंसेवक के तौर पर मदद कर रहे थे, और इसी दौरान उनका विक्रम से संपर्क हुआ। इससे
        तुरंत की ज़रूरतों (<a href="/hi/impact/storm-relief">तूफ़ान राहत के लिए तिरपाल</a>,
        <a href="/hi/impact/mosquito-nets">बरसात से पहले मच्छरदानियाँ</a>, राशन सहायता) और लंबी अवधि की
        योजना पर साथ काम शुरू हुआ, जिसमें समुदाय को समझने और कामों की रूपरेखा तय करने के लिए
        <a href="/hi/impact/surveys-and-research">हर घर की जनगणना (सर्वे)</a> भी शामिल थी।
      </p>
      <p>
        ये काम बार-बार रुकते रहे। बाढ़ ने परिवारों को बेघर किया, और डीडीए की तोड़फोड़ की कार्रवाइयों ने बार-बार
        बस्तियाँ खाली कराईं (<a href={src.maktoob2024}>Maktoob, 2024</a>; <a href={src.maktoob2026}>Maktoob, 2026</a>)। 2023 में
        लोक निर्माण विभाग (PWD) ने वनफूल पाठशाला को तोड़ दिया (<a href={src.rubble2023}>"Rising from the rubble", The Patriot, 2023</a>)। यह साफ़ हो गया कि इस काम के लिए
        समुदाय के पास एक स्थिर केंद्र चाहिए, जहाँ बच्चे पढ़ने आ सकें और परिवारों को दस्तावेज़ बनवाने में मदद मिल सके, और इसे
        चलाने का एक ज़्यादा व्यवस्थित तरीका भी चाहिए।
      </p>
      <p>
        इसी के लिए दिसंबर 2024 में नवयुग संस्कृति फ़ाउंडेशन का पंजीकरण हुआ, और जैसे-जैसे यह आकार लेता गया, मिहिर ने स्मिता कुनिगल
        को भी साथ जोड़ा। विक्रम समुदाय से गहरा जुड़ाव और यहाँ के बच्चों को सालों पढ़ाने का अनुभव लाते हैं; सृष्टि
        कानूनी और दस्तावेज़ों का काम संभालती हैं; मिहिर और स्मिता कार्यक्रम बनाने, डेटा इकट्ठा करने और
        मूल्यांकन का अनुभव लाते हैं, और इस काम को बड़े स्तर की रिसर्च और नीति से जोड़ते हैं। यह फ़ाउंडेशन उस काम को व्यवस्थित करने,
        उसके लिए पैसे जुटाने और उसे दूसरों तक पहुँचाने का ज़रिया है, जो विक्रम दस साल से ज़्यादा समय से करते आ रहे हैं।
      </p>
      <div class="btn-row">
        <a class="btn" href="/hi/team">टीम से मिलें</a>
        <a class="btn ghost" href="/hi/impact">हमारा असर</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container prose">
      <h2 style="margin-top:0">कानूनी और पंजीकरण की स्थिति</h2>
      <dl class="facts">
        <dt>पंजीकरण</dt>
        <dd>भारतीय न्यास अधिनियम, 1882 के तहत पब्लिक चैरिटेबल ट्रस्ट — पंजीकरण संख्या 2024/4/IV/2147, 26 दिसंबर 2024 को दिल्ली में पंजीकृत</dd>
        <dt>PAN</dt>
        <dd>AAETN8217A</dd>
        <dt>12A</dt>
        <dd>ट्रस्ट के लिए आयकर छूट (अस्थायी) — यूनिक रजिस्ट्रेशन नंबर AAETN8217AE20251, 10 मई 2025 को मिला, AY 2026-27 से AY 2028-29 तक मान्य</dd>
        <dt>80G</dt>
        <dd>भारतीय दानदाताओं के लिए टैक्स में छूट (अस्थायी) — यूनिक रजिस्ट्रेशन नंबर AAETN8217AF20251, 10 मई 2025 को मिला, AY 2026-27 से AY 2028-29 तक मान्य</dd>
        <dt>CSR-1</dt>
        <dd>कंपनियों से CSR फ़ंड लेने के लिए पात्र — पंजीकरण संख्या CSR00113586, दिनांक 27 जून 2026</dd>
        <dt>NGO दर्पण</dt>
        <dd>DL/2025/0575004, 24 मार्च 2025 को पंजीकृत</dd>
        <dt>पंजीकृत कार्यालय</dt>
        <dd>725/1, First Floor, Jheel Khuranja, Krishna Nagar, Govind Pura, Shahdara, East Delhi, Delhi – 110051</dd>
      </dl>
    </div>
  </section>
</Base>
